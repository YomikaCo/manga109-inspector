{
  "name": "manga109-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first static Manga109 image and annotation inspector for GitHub Pages.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node scripts/run-browser-tests.mjs",
    "verify": "pnpm run check && pnpm test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
